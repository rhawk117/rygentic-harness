{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mightymodels hook receipts",
  "oneOf": [
    {
      "$ref": "#/$defs/SubagentReceipt"
    },
    {
      "$ref": "#/$defs/DecisionReceipt"
    }
  ],
  "$defs": {
    "SubagentReceipt": {
      "title": "SubagentReceipt",
      "type": "object",
      "properties": {
        "agent": {
          "type": "string"
        },
        "agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stop_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "schema": {
          "type": "integer",
          "default": 1
        },
        "ticket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "head": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "at": {
          "type": "string"
        },
        "unavailable": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "agent",
        "agent_id",
        "agent_type",
        "status",
        "summary",
        "stop_reason",
        "ticket",
        "head",
        "at"
      ]
    },
    "DecisionReceipt": {
      "title": "DecisionReceipt",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "session": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "schema": {
          "type": "integer",
          "default": 1
        },
        "ticket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "head": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "at": {
          "type": "string"
        },
        "unavailable": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "id",
        "session",
        "question",
        "answer",
        "ticket",
        "head",
        "at"
      ]
    }
  }
}
