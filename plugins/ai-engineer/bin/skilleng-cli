#!/usr/bin/env python3
"""PATH launcher for skilleng — available while the ai-engineer plugin is enabled.

Inserts this script's own directory onto sys.path so `skilleng` is importable
regardless of the caller's cwd, then dispatches to the package's entry point.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from skilleng.cli import main

if __name__ == '__main__':
    raise SystemExit(main())
