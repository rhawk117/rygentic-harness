#!/usr/bin/env -S uv tool run --python >=3.14 --exclude-newer 2026-10-11T00:00:00Z --with duckdb==1.5.6 --with msgspec==0.22.0 --with numpy==2.5.4 --with polars==2.0.0 --with pyyaml==6.0.3 --with scipy==1.18.1 python
"""Run one of the python-harness data commands from the plugin directory this file lives in.

Usage: python-harness-data <alert-budget|paired-compare|profile-data|size-check> [arguments]

The shebang uses `uv tool run`, not `uv run`, for the reason `bin/python-harness` gives: the
environment is built from the pins on this line alone, never from the caller's project. The pins
sit here and not in `.mcp.json` or the other launchers, which must not carry the data packages.
`--exclude-newer` caps resolution so the packages the pins pull in cannot drift.
"""

import importlib
import sys
from collections.abc import Sequence
from pathlib import Path

COMMANDS = {
    'alert-budget': 'python_harness.scripts.data_analysis.alert_budget',
    'paired-compare': 'python_harness.scripts.data_analysis.paired_compare',
    'profile-data': 'python_harness.scripts.data_engineering.profile_data',
    'size-check': 'python_harness.scripts.data_engineering.size_check',
}


def main(argv: Sequence[str]) -> int:
    if not argv or argv[0] not in COMMANDS:
        print(f'usage: python-harness-data <{"|".join(COMMANDS)}> [arguments]', file=sys.stderr)
        return 2
    plugin_root = Path(__file__).resolve().parents[1]
    sys.path.insert(0, str(plugin_root.joinpath('src')))
    return importlib.import_module(COMMANDS[argv[0]]).main(list(argv[1:]))


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
